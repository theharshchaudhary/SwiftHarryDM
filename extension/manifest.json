{
  "manifest_version": 3,
  "name": "SwiftHarryDM Downloader",
  "version": "3.1.0",
  "description": "Send downloads, links, videos and audio to the SwiftHarryDM desktop app (paired, local only).",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SwiftHarryDM",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/download-icon.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
