{
  "manifest_version": 3,
  "name": "Keepfetch Downloader",
  "version": "3.1.0",
  "description": "Send downloads, links, videos and audio to the Keepfetch desktop app (paired, local only).",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "downloads",
    "nativeMessaging",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Keepfetch",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "key": ""
}
