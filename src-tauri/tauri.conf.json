{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftHarryDM",
  "version": "3.0.0",
  "identifier": "np.com.harshchaudhary.swiftharrydm",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SwiftHarryDM",
        "width": 1040,
        "height": 640,
        "minWidth": 720,
        "minHeight": 400,
        "visible": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMUQ1RTE2NDgxQUVEMDIKUldRQzdScElGbDRkM3JpNFdTRWI5c1JHZlcxVHpxNnBIc1ZtUjRNRENpRFN5dGdYa1dUejNDYWcK",
      "endpoints": [
        "https://github.com/theharshchaudhary/SwiftHarryDM/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
