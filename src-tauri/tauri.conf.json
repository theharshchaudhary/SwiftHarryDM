{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keepfetch",
  "version": "3.0.0",
  "identifier": "np.com.harshchaudhary.swiftharrydm",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Keepfetch",
        "width": 1040,
        "height": 640,
        "minWidth": 720,
        "minHeight": 400,
        "visible": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "../extension/": "extension/",
      "../tools/ffmpeg-slim/ffmpeg.exe": "tools/ffmpeg.exe",
      "../tools/ffmpeg-slim/ffprobe.exe": "tools/ffprobe.exe",
      "../tools/ffmpeg-slim/FFMPEG-LICENSE.txt": "tools/FFMPEG-LICENSE.txt",
      "../tools/ffmpeg-slim/LAME-LICENSE.txt": "tools/LAME-LICENSE.txt",
      "../tools/ffmpeg-slim/BUILD-INFO.txt": "tools/FFMPEG-BUILD-INFO.txt"
    },
    "publisher": "Harsh Chaudhary",
    "copyright": "© Harsh Chaudhary",
    "shortDescription": "Fast, resumable download manager",
    "longDescription": "Keepfetch downloads files, videos and audio with multiple connections, resumes after interruptions, and works with your browser.",
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMUQ1RTE2NDgxQUVEMDIKUldRQzdScElGbDRkM3JpNFdTRWI5c1JHZlcxVHpxNnBIc1ZtUjRNRENpRFN5dGdYa1dUejNDYWcK",
      "endpoints": [
        "https://github.com/theharshchaudhary/keepfetch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
